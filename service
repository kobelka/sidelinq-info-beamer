#!/usr/bin/python2.7
# -*- coding: utf-8 -*-
"""
Dienst auf dem Raspberry Pi: holt alle 10 Sekunden die Beamer-Daten des Turniers
von Sidelinq, lädt Vereinslogos und den QR-Code einmal herunter (verkleinert)
und schreibt alles nach data.json. node.lua zeichnet nur.

Läuft mit Python 2.7 (info-beamer OS), ist aber auch unter Python 3 lauffähig.
"""
from __future__ import print_function

import base64
import hashlib
import json
import os
import re
import sys
import time
import traceback
from io import BytesIO

try:
    from urlparse import urlparse  # Python 2
except ImportError:  # pragma: no cover
    from urllib.parse import urlparse  # Python 3

import requests
from PIL import Image, ImageDraw

try:
    import pytz
    BERLIN = pytz.timezone("Europe/Berlin")
except Exception:  # pragma: no cover
    BERLIN = None

VERSION = "1.0.4"
POLL_SECONDS = 10
FEED_VERSION = 1
LOGO_SIZE = 128
LOGO_MAX_BYTES = 3 * 1024 * 1024
MAX_LOGO_FILES = 150
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,79}$")
PATH_RE = re.compile(r"^/t/([^/]+)(?:/[a-z]+)?/?$")
HEADERS = {"User-Agent": "Sidelinq-info-beamer/%s" % VERSION, "Accept": "application/json"}

session = requests.Session()
session.headers.update(HEADERS)


def log(*args):
    print(*args, file=sys.stderr)
    sys.stderr.flush()


def write_atomic(name, data):
    tmp = name + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, name)


def read_config():
    try:
        with open("config.json") as f:
            return json.load(f)
    except Exception:
        return {}


def feed_url_from_link(link):
    """Beamer- oder Turnier-Link -> JSON-Adresse. Nur https (http nur für lokale Tests)."""
    link = (link or "").strip()
    if not link:
        return None
    if "://" not in link:
        link = "https://" + link
    try:
        u = urlparse(link)
    except Exception:
        return None
    if u.scheme not in ("https", "http") or not u.netloc:
        return None
    if u.scheme == "http" and not (u.hostname or "").startswith(("localhost", "127.", "192.168.", "10.")):
        return None
    m = PATH_RE.match(u.path or "")
    if not m or not SLUG_RE.match(m.group(1)):
        return None
    return "%s://%s/api/public/tournament-beamer/%s" % (u.scheme, u.netloc, m.group(1))


def clock_seconds():
    """Sekunden seit Mitternacht in deutscher Zeit (Uhr oben rechts)."""
    now = time.time()
    if BERLIN is not None:
        import datetime
        dt = datetime.datetime.fromtimestamp(now, BERLIN)
    else:  # pragma: no cover
        dt = time.localtime(now)
        return dt.tm_hour * 3600 + dt.tm_min * 60 + dt.tm_sec
    return dt.hour * 3600 + dt.minute * 60 + dt.second + (now % 1)


# ---------- Bilder ----------

logo_files = {}  # URL -> (Plakette, frei)
logo_failed_at = {}


def logo_names(url):
    """Plakette für dunklen Grund, freies Logo für hellen Grund (laufende Spiele)."""
    h = hashlib.sha1(url.encode("utf-8")).hexdigest()[:16]
    return "logo4-%s.png" % h, "logo4t-%s.png" % h


def free(img):
    """Logo ohne Hintergrund, durchsichtig wie geliefert."""
    resample = Image.LANCZOS if hasattr(Image, "LANCZOS") else Image.ANTIALIAS
    img = img.copy()
    img.thumbnail((LOGO_SIZE, LOGO_SIZE), resample)
    card = Image.new("RGBA", (LOGO_SIZE, LOGO_SIZE), (255, 255, 255, 0))
    card.paste(img, ((LOGO_SIZE - img.size[0]) // 2, (LOGO_SIZE - img.size[1]) // 2), img)
    return card


def plaque(img):
    """Runde weiße Plakette, Logo mittig im Kreis, außen durchsichtig."""
    resample = Image.LANCZOS if hasattr(Image, "LANCZOS") else Image.ANTIALIAS
    inner = int(LOGO_SIZE * 0.70)  # Quadrat passt ganz in den Kreis
    img = img.copy()
    img.thumbnail((inner, inner), resample)
    big = LOGO_SIZE * 4  # Kreis vierfach zeichnen und verkleinern = glatter Rand
    mask = Image.new("L", (big, big), 0)
    ImageDraw.Draw(mask).ellipse((0, 0, big - 1, big - 1), fill=255)
    mask = mask.resize((LOGO_SIZE, LOGO_SIZE), resample)
    card = Image.new("RGBA", (LOGO_SIZE, LOGO_SIZE), (255, 255, 255, 0))
    card.paste((255, 255, 255, 255), (0, 0, LOGO_SIZE, LOGO_SIZE), mask)
    card.paste(img, ((LOGO_SIZE - img.size[0]) // 2, (LOGO_SIZE - img.size[1]) // 2), img)
    return card


def fetch_logo(url):
    """Liefert (Plakette, frei) als Dateinamen oder (None, None)."""
    if not url:
        return None, None
    if url in logo_files:
        return logo_files[url]
    # Fehlgeschlagene Logos erst nach 5 Minuten erneut versuchen.
    if time.time() - logo_failed_at.get(url, 0) < 300:
        return None, None
    names = logo_names(url)
    if os.path.exists(names[0]) and os.path.exists(names[1]):
        logo_files[url] = names
        return names
    try:
        r = session.get(url, timeout=10, stream=True)
        r.raise_for_status()
        data = r.raw.read(LOGO_MAX_BYTES + 1, decode_content=True)
        if len(data) > LOGO_MAX_BYTES:
            raise ValueError("Logo zu groß")
        img = Image.open(BytesIO(data)).convert("RGBA")
        for name, make in zip(names, (plaque, free)):
            out = BytesIO()
            make(img).save(out, "PNG")
            write_atomic(name, out.getvalue())
        logo_files[url] = names
        return names
    except Exception as e:
        log("Logo nicht geladen:", url, e)
        logo_failed_at[url] = time.time()
        return None, None


def cleanup_logos(keep):
    files = [f for f in os.listdir(".") if f.startswith("logo") and f.endswith(".png")]
    old = [f for f in files if not f.startswith("logo4")]  # Bilder älterer Paketversionen
    if len(files) <= MAX_LOGO_FILES and not old:
        return
    for f in files:
        if f not in keep:
            try:
                os.unlink(f)
            except OSError:
                pass
    for url, names in list(logo_files.items()):
        if names[0] not in keep:
            del logo_files[url]


last_qr = [None]


def write_qr(data_url):
    if not data_url or data_url == last_qr[0]:
        return last_qr[0] is not None
    m = re.match(r"^data:image/png;base64,([A-Za-z0-9+/=]+)$", data_url)
    if not m:
        return False
    write_atomic("qr.png", base64.b64decode(m.group(1)))
    last_qr[0] = data_url
    return True


# ---------- Daten ----------

def localize_side(side, used):
    dark, light = fetch_logo(side.get("logo"))
    if dark:
        used.update((dark, light))
    side["logo"] = dark
    side["logoLight"] = light
    return side


def localize(feed):
    used = set()
    for key in ("live", "next", "recent"):
        for m in feed.get(key) or []:
            localize_side(m["home"], used)
            localize_side(m["away"], used)
    for page in feed.get("pages") or []:
        for panel in page:
            if panel.get("kind") == "table":
                for row in panel.get("rows") or []:
                    localize_side(row, used)
            else:
                for m in panel.get("matches") or []:
                    localize_side(m["home"], used)
                    localize_side(m["away"], used)
    for key in ("organizerLogo", "sponsorLogo"):
        dark, light = fetch_logo(feed.get(key))
        if dark:
            used.update((dark, light))
        feed[key] = dark
    feed["qr"] = "qr.png" if write_qr(feed.get("qr")) else None
    cleanup_logos(used)
    return feed


def drop_none(value):
    """null aus JSON entfernen: info-beamer liest null als wahren Wert, nicht als nil."""
    if isinstance(value, dict):
        return dict((k, drop_none(v)) for k, v in value.items() if v is not None)
    if isinstance(value, list):
        return [drop_none(v) for v in value if v is not None]
    return value


def publish(status, feed, message=None):
    out = {
        "status": status,
        "message": message,
        "clock": clock_seconds(),
        "fetched": time.time(),
        "feed": feed,
    }
    write_atomic("data.json", json.dumps(drop_none(out)).encode("utf-8"))


def main():
    last_feed = None
    last_url = None
    while True:
        started = time.time()
        url = feed_url_from_link(read_config().get("beamer_link"))
        if url != last_url:
            last_feed = None
            last_url = url
        try:
            if not url:
                publish("no_link", None, "Bitte im info-beamer-Setup den Beamer-Link aus Sidelinq eintragen.")
            else:
                r = session.get(url, timeout=8)
                if r.status_code == 404:
                    last_feed = None
                    publish("not_found", None, "Turnier nicht gefunden oder nicht veröffentlicht.")
                elif r.status_code == 429:
                    publish("stale", last_feed, "Zu viele Abrufe, gleich geht es weiter.")
                else:
                    r.raise_for_status()
                    feed = r.json()
                    if feed.get("v") != FEED_VERSION:
                        publish("update", last_feed, "Bitte das Paket in info-beamer aktualisieren.")
                    else:
                        last_feed = localize(feed)
                        publish("ok", last_feed)
        except Exception as e:
            log("Abruf fehlgeschlagen:", e)
            traceback.print_exc()
            publish("stale", last_feed, "Keine Verbindung zu Sidelinq.")
        time.sleep(max(1, POLL_SECONDS - (time.time() - started)))


if __name__ == "__main__":
    main()
